# ─── Site (Vercel) ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://mdssolution.com.br

# Encaminha /api/* do Next para o backend no Render (recomendado — cookies no mesmo domínio)
# Ex.: https://mds-api.onrender.com (sem barra no final)
RENDER_API_URL=

# Alternativa: API em subdomínio separado (exige CORS + SameSite=None)
# NEXT_PUBLIC_API_URL=https://api.mdssolution.com.br

# ─── Banco Neon (Vercel SSR + Render API) ─────────────────────────
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ─── Admin (login em /loginsolution) ──────────────────────────────
ADMIN_USERNAME=seu@email.com
ADMIN_PASSWORD=sua_senha_forte
# ADMIN_SESSION_SECRET=string_aleatoria_longa

# ─── Supabase (opcional — posts/produtos com Auth) ───────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Contato ─────────────────────────────────────────────────────
# CONTACT_WEBHOOK_URL=
